{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:waypointai:role-profile:1.0.0",
  "title": "WayPointAI role profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "vocabulary_version", "is_mock", "role_id", "display_title", "onet_code", "metadata", "onet_skills", "posting_skills"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "vocabulary_version": {"type": "string", "minLength": 1},
    "is_mock": {"type": "boolean"},
    "role_id": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
    "display_title": {"type": "string", "minLength": 1},
    "onet_code": {"type": ["string", "null"], "pattern": "^[0-9]{2}-[0-9]{4}\\.[0-9]{2}$"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "onet_skills": {"type": "array", "items": {"$ref": "#/$defs/onetSkill"}},
    "posting_skills": {"type": "array", "items": {"$ref": "#/$defs/postingSkill"}}
  },
  "allOf": [
    {
      "if": {"properties": {"metadata": {"properties": {"analyzed_postings_count": {"const": 0}}}}},
      "then": {
        "properties": {
          "metadata": {"properties": {"data_status": {"const": "insufficient_data"}}},
          "posting_skills": {"items": {"properties": {"mention_count": {"const": 0}, "mention_rate": {"type": "null"}, "evidence_sample": {"maxItems": 0}}}}
        }
      },
      "else": {"properties": {"posting_skills": {"items": {"properties": {"mention_rate": {"type": "number", "minimum": 0, "maximum": 1}}}}}}
    },
    {
      "if": {"properties": {"onet_code": {"type": "null"}}},
      "then": {"properties": {"onet_skills": {"maxItems": 0}}}
    }
  ],
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filters", "sources", "generated_at", "eligible_postings_count", "analyzed_postings_count", "excluded_unusable_descriptions_count", "data_status", "limitations"],
      "properties": {
        "filters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["occupation", "specialization", "seniority", "geography", "rules_version", "unknown_policy", "conflict_policy"],
          "properties": {
            "occupation": {"type": "string", "minLength": 1},
            "specialization": {"type": "string", "minLength": 1},
            "seniority": {"type": "string", "minLength": 1},
            "geography": {"type": "string", "minLength": 1},
            "rules_version": {"type": "string", "minLength": 1},
            "unknown_policy": {"const": "exclude_and_report"},
            "conflict_policy": {"const": "exclude_and_report"}
          }
        },
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
        "generated_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "eligible_postings_count": {"type": "integer", "minimum": 0},
        "analyzed_postings_count": {"type": "integer", "minimum": 0},
        "excluded_unusable_descriptions_count": {"type": "integer", "minimum": 0},
        "data_status": {"enum": ["unassessed", "insufficient_data", "limited_sample", "usable_sample"]},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_type", "uri", "version", "collection_dates", "status"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_type": {"enum": ["onet", "job_postings", "synthetic"]},
        "uri": {"type": ["string", "null"]},
        "version": {"type": ["string", "null"], "minLength": 1},
        "collection_dates": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["start", "end"],
              "properties": {
                "start": {"type": "string", "format": "date"},
                "end": {"type": "string", "format": "date"}
              }
            }
          ]
        },
        "status": {"enum": ["not_loaded", "loaded", "synthetic"]}
      }
    },
    "onetSkill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "element_id", "name", "category"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "element_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["posting_id", "excerpt", "requirement_context", "alternative_group_id", "uncertainty_flags"],
      "properties": {
        "posting_id": {"type": "string", "minLength": 1},
        "excerpt": {"type": "string", "minLength": 1},
        "requirement_context": {"enum": ["required", "preferred", "alternative", "explicitly_not_required", "unspecified"]},
        "alternative_group_id": {"type": ["string", "null"], "minLength": 1},
        "uncertainty_flags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {
          "if": {"properties": {"requirement_context": {"const": "alternative"}}},
          "then": {"properties": {"alternative_group_id": {"type": "string", "minLength": 1}}},
          "else": {"properties": {"alternative_group_id": {"type": "null"}}}
        }
      ]
    },
    "postingSkill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_id", "display_name", "category", "mention_count", "mention_rate", "evidence_sample"],
      "properties": {
        "canonical_id": {"type": "string", "pattern": "^skill:[a-z0-9]+(?:_[a-z0-9]+)*$"},
        "display_name": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "mention_count": {"type": "integer", "minimum": 0},
        "mention_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "evidence_sample": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence"}}
      }
    }
  }
}
