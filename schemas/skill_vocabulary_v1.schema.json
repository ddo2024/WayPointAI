{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:waypointai:skill-vocabulary:1.0.0",
  "title": "WayPointAI shared skill vocabulary v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "vocabulary_version", "is_mock", "skills"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "vocabulary_version": {"type": "string", "minLength": 1},
    "is_mock": {"type": "boolean"},
    "skills": {
      "type": "array",
      "items": {"$ref": "#/$defs/skill"}
    }
  },
  "$defs": {
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_id", "display_name", "category", "aliases", "matching_policy"],
      "properties": {
        "canonical_id": {"type": "string", "pattern": "^skill:[a-z0-9]+(?:_[a-z0-9]+)*$"},
        "display_name": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "matching_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["case_sensitive", "boundary", "overlap", "context_requirements"],
          "properties": {
            "case_sensitive": {"type": "boolean"},
            "boundary": {"const": "technology_token_v1"},
            "overlap": {"const": "longest_match_first"},
            "context_requirements": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["alias", "any_of_patterns"],
                "properties": {
                  "alias": {"type": "string", "minLength": 1},
                  "any_of_patterns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
                }
              }
            }
          }
        }
      }
    }
  }
}
